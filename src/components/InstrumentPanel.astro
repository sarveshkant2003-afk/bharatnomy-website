---
// A small "conditions" panel of real readings. Every value carries its year.
interface Row { label: string; value: string; note?: string }
interface Props { title: string; rows: Row[]; foot?: string; class?: string; id?: string; tone?: 'clm' | 'eng' | 'mac' | 'eqt' }
const { title, rows, foot, class: cls = '', id, tone } = Astro.props;
---
<section class:list={['panel', cls]} id={id} aria-label={title} data-tone={tone}>
  <span class="panel-plus" aria-hidden="true">+</span>
  <h3 class="label panel-title">{title}</h3>
  <dl class="panel-rows">
    {rows.map((r) => (
      <div class="panel-row">
        <dt class="label soft">{r.label}</dt>
        <dd class="panel-val num">{r.value}{r.note && <span class="label soft panel-note">{r.note}</span>}</dd>
      </div>
    ))}
  </dl>
  {foot && <p class="label soft panel-foot">{foot}</p>}
</section>
