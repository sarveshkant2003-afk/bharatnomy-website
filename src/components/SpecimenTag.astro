---
import { u } from '../lib/url';
// A dataset as a museum specimen / luggage tag hanging on a string.
import { tilt, rng } from '../lib/seed';
import type { DatasetMeta } from '../lib/data';
interface Props { dataset?: DatasetMeta; planned?: string; note?: string; state?: string; seed?: string; class?: string; headingTag?: 'h2' | 'h3' }
const { dataset: d, planned, note, state = 'Maharashtra', seed, class: cls = '', headingTag: H = 'h3' } = Astro.props;
const key = seed ?? d?.code ?? planned ?? 'tag';
const deg = tilt(key, 1);
const drop = Math.round(rng(key + 'drop')() * 20);
const base = d ? u(`/data/${d.slug}/${d.folder}`) : '';
---
<article class:list={['tag', { 'tag--planned': !d }, cls]} style={`--tilt:${deg}deg; --drop:${drop}px`}>
  <span class="tag-string" aria-hidden="true"></span>
  <span class="tag-hole" aria-hidden="true"></span>
  {d ? (
    <>
      <p class="label tag-code">{d.code}</p>
      <H class="display tag-title"><a href={u(`/datasets/${d.slug}`)}>{d.title}</a></H>
      <p class="label tag-cover">{state.toUpperCase()} · {d.districts} DISTRICTS · {d.first_year}–{d.last_year}</p>
      <dl class="tag-facts label">
        <div><dt>Columns</dt><dd class="num">{d.columns}</dd></div>
        <div><dt>Rows</dt><dd class="num">{d.rows.toLocaleString('en-IN')}</dd></div>
        <div><dt>Formats</dt><dd>CSV · JSON</dd></div>
        <div><dt>Size</dt><dd class="num">{d.csv_kb} KB CSV</dd></div>
      </dl>
      <p class="tag-dl">
        <a href={`${base}.csv`} download>CSV</a>
        <a href={`${base}.json`} download>JSON</a>
        <a href={u(`/datasets/${d.slug}`)}>Dataset page</a>
      </p>
    </>
  ) : (
    <>
      <p class="label tag-code">COMING</p>
      <H class="display tag-title">{planned}</H>
      {note && <p class="tag-note">{note}</p>}
    </>
  )}
</article>
