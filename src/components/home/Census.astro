---
// Chapter III signature move: "the hand-shaded census" (SCROLL.md §6), with
// three layers (temperature, rainfall, air quality) and power plant dots.
// Every frame of every layer is pre-rendered here with rough.js (fixed seeds),
// so no rough.js ships to the browser. src/scripts/home.ts crossfades the frames
// of the active layer, swaps layers on the buttons and draws the pen line from
// the act's --sc-p. Layer models live in src/lib/homeLayers.ts.
import { districtsGeo, stateGeo } from '../../lib/data';
import { frameFor, sketchDistricts, roughLine } from '../../lib/sketch';
import { scaleLinear } from 'd3-scale';
import { homeLayers, plantsFile, FUELS, plantRadius } from '../../lib/homeLayers';
import Legend from '../Legend.astro';
import { DATA_REPO, DATA_REF, HOME_LAYERS } from '../../config/data.mjs';

interface Props { width?: number; height?: number }
const { width = 640, height = 470 } = Astro.props;
const fc = districtsGeo();
const frame = frameFor(stateGeo(), width, height, 10);
const layers = homeLayers();
// districts without a value blend through the paper colour; the "no monitor"
// hatching is a separate overlay whose opacity crossfades (see home.ts)
const PAPER = '#FBFBF8';

const outline = sketchDistricts(fc, { frame, roughness: 0.7 });
const names = Object.fromEntries(outline.map((d) => [d.lgd, d.name]));

// the pen strip geometry (shared box, one curve per layer)
const SW = 1200, SH = 150, pad = { l: 44, r: 16, t: 18, b: 26 };

const built = layers.map((L, li) => {
  const shaded = L.frames.map((f) => sketchDistricts(fc, { frame, values: f.values, range: L.hatchRange, seedSalt: f.first + li * 7, roughness: 0.7 }));
  const colors = Object.fromEntries(outline.map((d) => [d.lgd, L.frames.map((f) => L.scale.color(f.values[d.lgd]) ?? PAPER)]));
  const nodata = L.nodataLabel ? Object.fromEntries(outline.map((d) => [d.lgd, L.frames.map((f) => (f.values[d.lgd] == null ? 1 : 0))])) : null;
  const p = L.pen;
  const x = scaleLinear().domain([p.years[0], p.years[p.years.length - 1]]).range([pad.l, SW - pad.r]);
  const y = scaleLinear().domain([p.y0, p.y1]).range([SH - pad.b, pad.t]).nice(3);
  const pts = p.years.map((yr, i) => [x(yr), y(p.mean[i] ?? 0)] as [number, number]);
  const pen = roughLine(pts, 1951 + li, 0.35);
  const tally = Object.fromEntries(outline.map((d) => [d.lgd, { name: d.name, a: L.frames[L.tally.iA]?.values[d.lgd] ?? null, b: L.frames[L.tally.iB]?.values[d.lgd] ?? null }]));
  const client = {
    id: L.id, sliderLabel: L.sliderLabel, aria: L.mapAria,
    frames: L.frames.map((f) => ({ label: f.label, first: f.first, last: f.last })),
    colors, nodata, tally, labA: L.tally.labA, labB: L.tally.labB, unit: L.tally.unit, signed: L.tally.signed,
    pen: { years: p.years, mean: p.mean, x0: pad.l, x1: SW - pad.r, y0: y.domain()[0], y1: y.domain()[1], top: pad.t, bottom: SH - pad.b },
  };
  return { L, shaded, x, y, pen, client };
});

// power plants: projected once; big first so small dots sit on top
const P = plantsFile();
const fuelColor = Object.fromEntries(FUELS.map((f) => [f.id, f.color]));
const plants = P.plants.map((pl) => {
  const [cx, cy] = frame.project([pl.lon, pl.lat]);
  return { ...pl, cx: +cx.toFixed(1), cy: +cy.toFixed(1), r: plantRadius(pl.mw), color: fuelColor[pl.fuel] ?? '#4C535C' };
});
const fuelsPresent = FUELS.filter((f) => plants.some((p) => p.fuel === f.id)).map((f) => ({ ...f, n: plants.filter((p) => p.fuel === f.id).length }));
const plantCards = plants.map((p) => `${p.name.toUpperCase()} · ${p.fuel.toUpperCase()} · ${Math.round(p.mw).toLocaleString('en-IN')} MW · ${p.district.toUpperCase()}${p.year ? ` · SINCE ${p.year}` : ''}`);
const first = built[0];
const plantsHref = `${DATA_REPO}/tree/${DATA_REF}/${HOME_LAYERS.plants.path}`;
---
<div class="census plants-mono" data-census data-layers={JSON.stringify(built.map((b) => b.client))} data-plant-cards={JSON.stringify(plantCards)}>
  <div class="census-map">
    <div class="census-controls">
      <p class="census-decade display" aria-live="off" data-decade></p>
      <div class="layer-switch" role="group" aria-label="Map layer">
        {layers.map((L, i) => <button type="button" class="layer-btn label" data-layer-btn={L.id} aria-pressed={i === 0 ? 'true' : 'false'}>{L.button}</button>)}
      </div>
      <button type="button" class="plant-toggle label" data-plants-toggle aria-pressed="true">
        <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="4" /></svg><span class="m-long">Power plants</span><span class="m-short">Plants</span>
      </button>
      <button type="button" class="plant-toggle fuel-toggle label" data-fuel-toggle aria-pressed="false"><span class="m-long">By fuel</span><span class="m-short">Fuel</span></button>
    </div>
    <svg class="sketch census-svg" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={first.L.mapAria} data-map-svg>
      <defs>
        <pattern id="census-nodata" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#4C535C" stroke-width="0.8" opacity="0.55" />
        </pattern>
      </defs>
      <g class="census-fill">{outline.map((d) => <path data-lgd={d.lgd} d={d.plain} />)}</g>
      <g class="census-nodata">{outline.map((d) => <path data-lgd={d.lgd} d={d.plain} fill="url(#census-nodata)" />)}</g>
      {built.map((b, li) => (
        <g class="census-layer" data-layer={b.L.id} hidden={li !== 0}>
          {b.shaded.map((ds, k) => (
            <g class="census-frame" data-frame={k}>{ds.map((d) => d.hatch.length > 0 && <path class="sk-hatch" d={d.hatch.join(' ')} />)}</g>
          ))}
        </g>
      ))}
      <g class="census-outline" id="census-outline">
        {outline.map((d) => (
          <g class="sk-d" data-lgd={d.lgd}><path class="sk-hit" d={d.plain} /><path class="sk-line" d={d.outline.join(' ')} /></g>
        ))}
      </g>
      <g class="census-plants" data-plants aria-hidden="true">
        {plants.map((p, i) => p.year
          ? <circle data-i={i} data-y={p.year} cx={p.cx} cy={p.cy} r={p.r} style={`--c:${p.color}`} />
          : <circle class="undated" data-i={i} cx={p.cx} cy={p.cy} r={p.r} style={`--c:${p.color}`} />)}
      </g>
    </svg>
    <div class="census-tally label" data-tally-card hidden></div>
    <div class="census-ruler">
      <label class="label" for="census-slider" data-slider-label>{first.L.sliderLabel}</label>
      <input id="census-slider" type="range" min="0" max={first.L.frames.length - 1} step="1" value="0" data-slider
        aria-valuetext={first.L.frames[0].label} />
      {built.map((b, li) => (
        <ol class="census-ticks label" aria-hidden="true" data-layer-ticks={b.L.id} hidden={li !== 0}>{b.L.frames.map((f) => <li>{b.L.id === 'aqi' ? `’${f.tick.slice(2)}` : f.tick}</li>)}</ol>
      ))}
    </div>
    <div class="census-legends">
      {built.map((b, li) => (
        <div data-layer-legend={b.L.id} hidden={li !== 0}>
          <Legend class="census-legend" title={b.L.legendTitle} entries={b.L.scale.legend} nodata={!!b.L.nodataLabel} nodataLabel={b.L.nodataLabel} seed={`census-${b.L.id}`} />
        </div>
      ))}
      <figure class="legend plant-legend" data-plant-legend>
        <figcaption class="label legend-title"><span class="m-long">Power plants · {plants.length} · dot size = capacity</span><span class="m-short">Plants · size = MW</span></figcaption>
        <ul class="plant-legend-list" data-fuel-legend hidden>
          {fuelsPresent.map((f) => <li><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4.5" style={`fill:${f.color}`} /></svg><span class="mono">{f.label}<span class="m-long"> {f.n}</span></span></li>)}
        </ul>
        <p class="mono plant-note">● appears in its commissioning year · ○ year not published</p>
      </figure>
    </div>
  </div>

  <div class="census-lines">
    <div data-layer-lines="temperature"><slot name="temperature" /></div>
    <div data-layer-lines="rainfall" hidden><slot name="rainfall" /></div>
    <div data-layer-lines="aqi" hidden><slot name="aqi" /></div>
    <slot />
  </div>

  <figure class="census-strip">
    {built.map((b, li) => (
      <div class="strip-layer" data-layer-pen={b.L.id} hidden={li !== 0}>
        <svg viewBox={`0 0 ${SW} ${SH}`} preserveAspectRatio="none" role="img" aria-label={b.L.pen.aria}>
          <defs><clipPath id={`pen-clip-${b.L.id}`}><rect x="0" y="0" width={SW} height={SH} data-pen-clip /></clipPath></defs>
          {b.L.pen.band && <rect class="strip-band" x={b.x(Math.max(b.L.pen.band[0], b.L.pen.years[0]))} y={pad.t} width={b.x(b.L.pen.band[1]) - b.x(Math.max(b.L.pen.band[0], b.L.pen.years[0]))} height={SH - pad.t - pad.b} />}
          {b.y.ticks(3).map((t) => <g><line class="trend-grid" x1={pad.l} x2={SW - pad.r} y1={b.y(t)} y2={b.y(t)} /><text class="trend-tick" x={pad.l - 8} y={b.y(t) + 3} text-anchor="end">{t > 0 && b.L.pen.zero ? `+${t}` : t}</text></g>)}
          {b.L.pen.zero && <line class="trend-axis" x1={pad.l} x2={SW - pad.r} y1={b.y(0)} y2={b.y(0)} />}
          <line class="trend-axis" x1={pad.l} x2={SW - pad.r} y1={SH - pad.b} y2={SH - pad.b} />
          {b.L.pen.ticks.map((t) => <g><line class="trend-axis" x1={b.x(t)} x2={b.x(t)} y1={SH - pad.b} y2={SH - pad.b + 5} /><text class="trend-tick" x={b.x(t)} y={SH - 6} text-anchor="middle">{t}</text></g>)}
          <path class="strip-pen" d={b.pen} clip-path={`url(#pen-clip-${b.L.id})`} />
          <g class="strip-nib" data-pen-nib><circle r="4" /><line x1="0" y1="-5" x2="7" y2="-16" /></g>
        </svg>
        <figcaption class="label soft">{b.L.pen.caption}</figcaption>
        <p class="source label census-src">
          {b.L.id === 'temperature' && <slot name="src-temperature" />}
          {b.L.id === 'rainfall' && <slot name="src-rainfall" />}
          {b.L.id === 'aqi' && <slot name="src-aqi" />}
          {' · '}PLANTS: WRI GLOBAL POWER PLANT DATABASE V1.3 (2021), PLANTS BUILT AFTER ABOUT 2020 MISSING · <a href={plantsHref}>DATA</a>
        </p>
      </div>
    ))}
  </figure>
</div>
