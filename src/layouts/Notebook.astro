---
import { u } from '../lib/url';
// Shared page shell: paper, grid, instrument strip, footer (PAGES.md).
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource/geist/400.css';
import '@fontsource/geist/400-italic.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/paper.css';
import '../styles/components.css';
import InstrumentStrip from '../components/InstrumentStrip.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  code: string;
  coords?: string;
  coordsLabel?: string;
  noindex?: boolean;
  bodyClass?: string;
}
const { title, description, code, coords, coordsLabel, noindex = false, bodyClass } = Astro.props;
const fullTitle = title === 'Bharatnomy' ? title : `${title} · Bharatnomy`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#F2F3EF" />
    <script is:inline>document.documentElement.classList.add('js');
      (function () {
        var ok = ['dots', 'fine', 'major', 'wide', 'lines'], p = null;
        try { p = new URLSearchParams(location.search).get('paper') || localStorage.getItem('bn-paper'); } catch (e) {}
        document.documentElement.dataset.paper = ok.indexOf(p) > -1 ? p : 'dots';
      })();</script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <InstrumentStrip code={code} coords={coords} coordsLabel={coordsLabel} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/notebook';
    </script>
    <div class="paper-toggle" role="group" aria-label="Paper pattern (preview)">
      <span>Paper</span>
      <button type="button" data-paper-opt="dots" title="Classic dot grid, 20px">Dots</button>
      <button type="button" data-paper-opt="fine" title="Fine dot grid, 12px">Fine</button>
      <button type="button" data-paper-opt="major" title="Dot grid with a heavier dot every fifth square">Major</button>
      <button type="button" data-paper-opt="wide" title="Wide dot grid, 32px">Wide</button>
      <button type="button" data-paper-opt="lines" title="Previous graph-paper lines">Lines</button>
    </div>
    <script is:inline>
      (function () {
        var root = document.documentElement, btns = document.querySelectorAll('[data-paper-opt]');
        function sync() { btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.paperOpt === root.dataset.paper)); }); }
        btns.forEach(function (b) { b.addEventListener('click', function () {
          root.dataset.paper = b.dataset.paperOpt;
          try { localStorage.setItem('bn-paper', b.dataset.paperOpt); } catch (e) {}
          sync();
        }); });
        sync();
      })();
    </script>
    <slot name="end" />
  </body>
</html>
