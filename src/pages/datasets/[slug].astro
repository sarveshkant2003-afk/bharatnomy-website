---
import { u } from '../../lib/url';
// BN-DATA: one lab-report page per dataset, generated from its README at build
// time, so updating the data repo updates the page.
import Notebook from '../../layouts/Notebook.astro';
import InstrumentPanel from '../../components/InstrumentPanel.astro';
import MarginNote from '../../components/MarginNote.astro';
import SketchMap from '../../components/SketchMap.astro';
import TrendChart from '../../components/TrendChart.astro';
import Legend from '../../components/Legend.astro';
import Button from '../../components/Button.astro';
import StickerLabel from '../../components/StickerLabel.astro';
import { stats, readme, metricFile, yearSlice, districts, spanOf } from '../../lib/data';
import { chicago } from '../../lib/cite';
import { parseReadme, block, inline, tableRows, bullets } from '../../lib/md';
import { classify } from '../../lib/scales';
import { stampDate, fmt, noEmDash } from '../../lib/format';
import { METRICS } from '../../config/metrics.mjs';
import '../../styles/pages.css';

export function getStaticPaths() {
  return stats().datasets.map((d) => ({ params: { slug: d.slug } }));
}

const s = stats();
const d = s.datasets.find((x) => x.slug === Astro.params.slug)!;
const r = parseReadme(readme(d.slug));
const sec = r.sections;
const source = sec['Source'] ?? '';
const scriptUrl = source.match(/\*\*Script:\*\*.*?\((https?:[^)]+)\)/)?.[1];
const downloaded = source.match(/\*\*Downloaded:\*\*\s*(.+)/)?.[1]?.trim();
const columns = tableRows(sec['Columns'] ?? '');
const notes = bullets(sec['Notes from the warehouse'] ?? '').map(noEmDash);
const method = sec['How it is computed'] ?? sec['Bharatnomy calculation'] ?? '';
const meta = METRICS.find((m) => m.id === d.defaultMetric)!;
const mf = metricFile(d.slug, d.defaultMetric);
const latest = mf.years[mf.years.length - 1];
const vals = yearSlice(mf, latest) as Record<string, number>;
const cls = classify({ kind: meta.scale as any, breaks: meta.breaks, values: Object.values(vals), decimals: meta.decimals, unit: meta.unit, fixed: meta.fixed });
const colors = Object.fromEntries(Object.entries(vals).map(([k, v]) => [k, cls.color(v)]));
const vv = Object.values(vals).filter((v) => v != null).sort((a, b) => a - b);
const yl = (y: number) => d.year_labels[y] ?? String(y);
const span = spanOf(d);
const baseline = d.baseline ?? undefined;
const stateLabel = d.stateLabel ?? `${s.district_count}-district average`;
const longRecord = mf.years.length >= 30;
const srcLine = `${d.source.toUpperCase()}, ${span} · ${d.computed.toUpperCase()}`;
const tone = d.lens.startsWith('Energy') ? 'eng' : 'clm';
const cite = chicago({ title: d.title, place: 'Maharashtra', span, code: d.code, version: s.data.short, released: s.data.date, url: `https://bharatnomy.com/datasets/${d.slug}`, agency: d.agency });
const atlas = u(`/atlas?dataset=${d.slug}&metric=${d.defaultMetric}&year=${latest}`);
const ds = districts();
const top = Object.entries(vals).sort((a, b) => b[1] - a[1])[0];
const topName = ds.find((x) => x.lgd === top[0])?.name;
---
<Notebook title={d.title} description={noEmDash(r.intro.split('\n')[0])} code="BN-DATA">
  <article class="lab sheet">
    <header class="lab-head">
      <p class="label soft"><a href={u("/datasets")}>Datasets</a> / {d.code}</p>
      <h1 class="display t-xl">{d.title}</h1>
      <p class="label lab-cover">MAHARASHTRA · {d.districts} DISTRICTS · {span} · {d.lens.toUpperCase()}</p>
    </header>

    <div class="lab-main">
      <p class="t-lead lab-summary" set:html={inline(noEmDash(r.intro))} />

      <figure class="lab-map">
        <SketchMap title={`${meta.label}, ${yl(latest)}`} values={vals} range={[vv[0], vv[vv.length - 1]]} colors={colors} unit={meta.unit} width={620} height={455} seedSalt={latest} />
        <Legend title={`${meta.short} · ${yl(latest)}${meta.unit && meta.unit !== 'SPI' ? ' · ' + meta.unit.toUpperCase() : ''}`} entries={d.noData ? [...cls.legend, { color: 'transparent', label: d.noData }] : cls.legend} seed={d.slug} />
        <figcaption class="source label">SOURCE: {srcLine} · {meta.label.toUpperCase()} · {yl(latest).toUpperCase()} · <a href={atlas}>OPEN IN ATLAS</a></figcaption>
      </figure>

      <section class="lab-sec" aria-labelledby="s-what">
        <h2 id="s-what" class="display t-m">What is in it</h2>
        <p>One row per {d.rowUnit}: {d.rows.toLocaleString('en-IN')} rows, {d.columns} columns{d.aggregate ? <>, added up into {d.districts} districts on the maps</> : <>, {d.districts} districts</>}, {span.replace('–', ' to ')}. In {yl(latest)}, the highest {meta.short.toLowerCase()} was in {topName}: {fmt(top[1], meta.decimals)}{meta.unit === '%' ? '%' : ' ' + meta.unit}.</p>
        <Fragment set:html={block(source)} />
      </section>

      <section class="lab-sec" aria-labelledby="s-how">
        <h2 id="s-how" class="display t-m">How it is computed</h2>
        <Fragment set:html={block(method)} />
        {d.aggregate && <p>On this site, the rows are added up by the district each {d.aggregate === 'odf' ? 'village count belongs to' : d.aggregate === 'plants' ? 'plant stands in' : 'station stands in'}, on 2011 boundaries (Palghar's rows go into Thane), and shares and per-unit figures are recomputed from those totals. The district totals are a separate download.</p>}
      </section>

      <section class="lab-sec" aria-labelledby="s-cols">
        <h2 id="s-cols" class="display t-m">Columns</h2>
        <div class="table-wrap">
          <table class="dense">
            <thead><tr><th scope="col">Column</th><th scope="col">Meaning</th><th scope="col">Unit</th></tr></thead>
            <tbody>{columns.map((c) => <tr><td><code>{c[0].replace(/`/g, '')}</code></td><td set:html={inline(c[3] ?? '')} /><td class="mono">{c[2] || '–'}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section class="lab-sec" aria-labelledby="s-notes">
        <h2 id="s-notes" class="display t-m">Notes and caveats</h2>
        <ul>{notes.map((n) => <li set:html={inline(n)} />)}</ul>
      </section>

      <section class="lab-sec" aria-labelledby="s-trend">
        <h2 id="s-trend" class="display t-m">Over time</h2>
        {mf.years.length >= 5 ? (
          <>
            <TrendChart
              caption={`${stateLabel} · ${meta.label} · ${span}`}
              years={mf.years} series={[{ label: stateLabel, values: mf.state_mean as number[], style: 'faint' }]}
              rolling={longRecord ? 10 : undefined} baseline={baseline} highlight={latest} zeroLine={meta.breaks !== 'quantile'}
              unit={meta.unit} decimals={meta.decimals} title={`${meta.label}, ${stateLabel}`} xLabel={yl}
              width={720} height={250} source={srcLine} href={atlas}
            />
            <p class="soft lab-small">{d.stateLabel ? `${d.stateLabel}: every district added up, with per-unit figures recomputed from the totals.` : `The ${stateLabel} is a simple mean of the districts, not weighted by area.`}{longRecord && ' The blue line is the 10-year rolling mean.'}{baseline && ` The shaded band is the ${baseline[0]} to ${baseline[1]} normal.`}</p>
          </>
        ) : (
          <>
            <p>{mf.years.length === 1 ? `This release covers one year, ${yl(mf.years[0])}, so there is no trend yet.` : `This release has ${mf.years.length} dates, so here are the state figures for each.`}</p>
            <div class="table-wrap">
              <table class="dense">
                <thead><tr><th scope="col">{d.time === 'date' ? 'Date' : 'Year'}</th>{d.metrics.map((id) => <th scope="col" class="r">{METRICS.find((x) => x.id === id)!.short}</th>)}</tr></thead>
                <tbody>{mf.years.map((y, i) => (
                  <tr><td class="num">{yl(y)}</td>{d.metrics.map((id) => { const mm = METRICS.find((x) => x.id === id)!; const v = metricFile(d.slug, id).state_mean?.[i]; return <td class="num r">{v == null ? '–' : `${fmt(v, mm.decimals)}${mm.unit === '%' ? '%' : ''}`}</td>; })}</tr>
                ))}</tbody>
              </table>
            </div>
            <p class="soft lab-small">{stateLabel}: every district added up, with shares recomputed from the totals.</p>
          </>
        )}
      </section>

      <section class="lab-sec" aria-labelledby="s-changes">
        <h2 id="s-changes" class="display t-m">Changes</h2>
        <p>This release is built from the data repo at commit <a href={`${s.data.repo}/tree/${s.data.commit}/${d.path}`}><code>{s.data.short}</code></a> ({stampDate(s.data.date)}){downloaded && <>, from source files downloaded on {downloaded}</>}. Any change to the data or method will be listed here with its date.</p>
      </section>

      <section class="lab-sec" aria-labelledby="s-cite">
        <h2 id="s-cite" class="display t-m">How to cite</h2>
        <p class="soft">Chicago style (17th edition). Use the form your publication follows; the version is the data commit, so a citation points at the exact files you downloaded.</p>
        <div class="cite-block">
          <p class="label">Author-date · reference list</p>
          <p class="cite mono" id="cite-ref">{cite.reference}</p>
          <p class="label soft">In text: {cite.inText} <button type="button" class="label cite-copy" data-copy="cite-ref">Copy reference</button></p>
        </div>
        <div class="cite-block">
          <p class="label">Notes and bibliography · footnote</p>
          <p class="cite mono" id="cite-note">1. {cite.note}</p>
          <p class="label">Bibliography</p>
          <p class="cite mono" id="cite-bib">{cite.bibliography}</p>
          <p class="label soft"><button type="button" class="label cite-copy" data-copy="cite-note">Copy note</button> <button type="button" class="label cite-copy" data-copy="cite-bib">Copy bibliography entry</button></p>
        </div>
      </section>
    </div>

    <aside class="lab-side">
      <div class="lab-side-inner">
        <InstrumentPanel tone={tone} title={`${d.code} · COVERAGE`} rows={[
          { label: 'Districts', value: String(d.districts), note: '2011 BOUNDARIES' },
          { label: d.time === 'date' ? 'Dates' : 'Years', value: span },
          { label: 'Rows', value: d.rows.toLocaleString('en-IN') },
          { label: 'Columns', value: String(d.columns) },
          { label: 'Licence', value: 'CC BY 4.0' },
        ]} foot={`DATA @ ${s.data.short}`} />
        <div class="lab-dl">
          <Button href={u(`/data/${d.slug}/${d.folder}.csv`)} download primary arrow="↓">CSV · {d.csv_kb} KB</Button>
          <Button href={u(`/data/${d.slug}/${d.folder}.json`)} download arrow="↓">JSON · {d.json_kb} KB</Button>
          {d.totals_kb != null && <Button href={u(`/data/${d.slug}/${d.folder}_district-totals.csv`)} download arrow="↓">District totals · {d.totals_kb} KB</Button>}
          <Button href={u(`/data/${d.slug}/README.md`)} download arrow="↓">README (.md)</Button>
          <Button href={atlas}>Open in Atlas</Button>
        </div>
        <p class="lab-links mono"><a class="ext" href={d.sourceUrl}>Source: {d.sourceLink}</a>{scriptUrl && <><br /><a class="ext" href={scriptUrl}>Build script on GitHub</a></>}</p>
        <div class="lab-notes">
          {d.notes.map((n) => <MarginNote label={n.label}>{n.text}</MarginNote>)}
        </div>
        <StickerLabel text={`CITE: BHARATNOMY ${s.data.date.slice(0, 4)} · CHICAGO`} seed={`cite-${d.slug}`} />
      </div>
    </aside>
  </article>
  <script>
    // copy a citation; the button says so for a moment
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
      const text = document.getElementById(b.dataset.copy!)?.textContent?.trim() ?? '';
      const was = b.textContent;
      try { await navigator.clipboard.writeText(text); b.textContent = 'Copied'; } catch { b.textContent = 'Select and copy the text'; }
      setTimeout(() => { b.textContent = was; }, 1600);
    }));
  </script>
</Notebook>
